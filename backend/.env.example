# Copy this file to .env and adjust values as needed.

PORT=5000

# CORS: the origin your Vite frontend runs on
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string. Local example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/dr-screening
# MongoDB Atlas example:
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dr-screening
MONGODB_URI=your mongo url

# Secret used to sign login tokens - change this to a long random string
# in any real deployment. Tokens expire after JWT_EXPIRES_IN.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Path to the MATLAB executable, used by the (currently stubbed) analysis
# pipeline in src/utils/runMatlabPipeline.js. Leave as-is if you don't have
# MATLAB set up yet - the analyze endpoint will fall back to mock data.
# Windows example:
MATLAB_EXE=C:\Program Files\MATLAB\R2026a\bin\matlab.exe
# macOS example:
# MATLAB_EXE=/Applications/MATLAB_R2026a.app/bin/matlab
# Linux example:
# MATLAB_EXE=/usr/local/MATLAB/R2026a/bin/matlab

# Path to the root of the MATLAB project (the folder containing src/segmentation,
# src/quality, src/classification, src/explainability, runPipelineForWeb.m, etc.)
# Point this at your DR-Screening-main project folder.
MATLAB_PROJECT_ROOT=../DR-Screening-main
